+
+/// WASI entry point — the `JsValue`-free twin of [`process_image`], added so the
+/// crate can be built for `wasm32-wasip1` without wasm-bindgen's JS glue.
+/// `palette_hex` is a comma-separated list of hex colors: `"0d2b45,ffecd6"`.
+#[cfg(all(target_arch = "wasm32", target_os = "wasi"))]
+pub fn process_image_wasi(
+    input_bytes: &[u8],
+    k_colors: Option<u32>,
+    pixel_size_override: Option<f64>,
+    palette_hex: Option<&str>,
+) -> Result<Vec<u8>> {
+    let mut config = Config::default();
+    if let Some(k) = k_colors {
+        if k == 0 {
+            return Err(PixelSnapperError::InvalidInput(
+                "k_colors must be greater than 0".to_string(),
+            ));
+        }
+        config.k_colors = k as usize;
+    }
+
+    config.pixel_size_override = pixel_size_override;
+    config.palette = palette_hex.map(parse_palette_hex).transpose()?;
+
+    process_image_common(input_bytes, Some(config)).map(|processed| processed.output_bytes)
+}
